choice PLATFORM
	prompt "Platform selection"
	default ASIC

config EMULATOR_FPGA
	bool "FPGA platform."
	imply CACHE

config EMULATOR_SYSTEMC
	bool "SystemC emulator platform."

config ASIC
	bool "ASIC"
	imply CACHE
	help
	  ASIC platform.

endchoice
